{
    "name": "flytachi/winter-redis",
    "description": "Pooled Redis for long-running PHP — coroutine-safe connections, typed stores and an optional PSR-16 adapter.",
    "type": "library",
    "license": "MIT",
    "scripts": {
        "test": "phpunit",
        "test-ci": "phpunit --fail-on-skipped",
        "test-detail": "phpunit --testdox",
        "cs-check": "phpcs .",
        "cs-fix": "phpcbf ."
    },
    "autoload": {
        "psr-4": {
            "Flytachi\\Winter\\Redis\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Flytachi\\Winter\\Redis\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": ">=8.4",
        "ext-redis": "*",
        "flytachi/winter-cpool": "^1.0",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "@stable",
        "squizlabs/php_codesniffer": "@stable",
        "swoole/ide-helper": "^6.0"
    },
    "suggest": {
        "ext-swoole": "Enables real connection pooling; without it a single self-maintaining connection is used."
    },
    "homepage": "https://winterframe.net",
    "support": {
        "issues": "https://github.com/flytachi/winter-redis/issues",
        "source": "https://github.com/flytachi/winter-redis",
        "docs": "https://winterframe.net/packages/redis"
    },
    "keywords": [
        "php",
        "redis",
        "cache",
        "pool",
        "coroutine",
        "swoole",
        "winter"
    ],
    "authors": [
        {
            "name": "Flytachi",
            "email": "jason.khan.x@gmail.com"
        }
    ],
    "scripts-descriptions": {
        "test": "Run the test suite; classes that need a live Redis are skipped when none answers.",
        "test-ci": "Same, but a skipped test fails the run — a suite that tested nothing must not report success.",
        "test-detail": "Run the test suite with testdox output.",
        "cs-check": "Check coding standards (PSR-12).",
        "cs-fix": "Fix coding standards automatically."
    }
}
